# Tên miền đi qua lớp bảo vệ OneShield (DNS + WAF) của nhà cung cấp:
#   Người dùng ──HTTPS (chứng chỉ Let's Encrypt của OneShield)──► OneShield ──HTTPS:443──► Caddy ──► web
# OneShield đã lo chứng chỉ công khai và chuyển HTTP sang HTTPS, nên ở đây Caddy chỉ cần
# một chứng chỉ tự ký để mã hoá chặng OneShield → máy chủ.
{
	auto_https disable_redirects
	default_sni {$DOMAIN:localhost}
}

(app) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Diễn đàn gửi ảnh/video dạng base64 qua API kiểm duyệt — giới hạn thân request
	request_body {
		max_size 30MB
	}

	# Tệp người dùng tải lên: Caddy trả thẳng từ /srv/tnth/uploads (gắn chỉ đọc), không qua Next.js.
	# Tên tệp là mã băm nội dung, không bao giờ đổi → cache 1 năm. Không liệt kê thư mục.
	handle_path /uploads/* {
		root * /srv/uploads
		header {
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options nosniff
		}
		# Ảnh/video/âm thanh: không cho chạy script dù trình duyệt mở trực tiếp
		@media path *.webp *.mp4 *.mov *.webm *.mp3
		header @media Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
		# Văn bản Office, tệp nén, txt/csv: luôn tải xuống, không mở trong trình duyệt
		@download path *.doc *.docx *.xls *.xlsx *.ppt *.pptx *.zip *.rar *.7z *.txt *.csv
		header @download Content-Disposition attachment
		file_server
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

# Truy cập thẳng bằng IP (http://103.216.116.242) — không cho máy tìm kiếm lập chỉ mục địa chỉ IP
http:// {
	header X-Robots-Tag "noindex"
	import app
}

# Địa chỉ chính thức, đặt DOMAIN trong .env
https://{$DOMAIN:localhost} {
	tls internal

	# TẠM THỜI: chỉ cho máy tìm kiếm lập chỉ mục trang chủ, vì nội dung còn là dữ liệu mẫu.
	# Khi có nội dung thật: xoá 2 dòng dưới rồi chạy `docker compose restart proxy`.
	@noindex not path / /robots.txt /sitemap.xml
	header @noindex X-Robots-Tag "noindex"

	import app
}

# Bản www chuyển hẳn về địa chỉ chính để Google không coi là hai website
https://www.{$DOMAIN:localhost} {
	tls internal
	redir https://{$DOMAIN:localhost}{uri} permanent
}
